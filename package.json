    "build:mac": "electron-builder --mac   --config electron-builder.json",
    "build:linux": "electron-builder --linux --config electron-builder.json",
    "build:all": "electron-builder --win --mac --linux --config electron-builder.json",
    "postinstall": "electron-builder install-app-deps && node scripts/ensure-electron-binary.js",
    "icons:mac": "bash scripts/gen-icns.sh",
    "icons:win": "node scripts/gen-ico.js",
    "test": "node test/rag.test.js && node test/vision.test.js && npm run test:alibaba && npm run test:provider-capabilities && npm run test:provider-availability && npm run test:provider-readiness && npm run test:conversation-context && npm run test:update-check && npm run test:third-party-notices && npm run test:provider-credentials && npm run test:provider-registry && npm run test:request-context && npm run test:provider-cancellation && npm run test:ollama-cancellation && npm run test:xlsx-vendored && npm run test:cloud-consent && npm run test:network-security && npm run test:knowledge-cli && npm run test:ensure-electron-binary && npm run test:ci-gates && npm run test:palette && npm run test:visual-ui-shell && npm run test:visual-ui-conversation && npm run test:electron-test-isolation && npm run test:kill-survivors && npm run test:visual-ui-polish && npm run test:ipc-contracts && npm run test:website-i18n && node test/security-regressions.test.js",
    "test:all": "bash scripts/run-stage0a-gates.sh",
    "test:gui": "bash scripts/run-gui-gates.sh",
    "test:db": "node scripts/run-electron-test.js test/db.test.js",
    "test:rag": "node test/rag.test.js",
    "test:vision": "node test/vision.test.js",
    "test:provider-capabilities": "node test/provider-capabilities.test.js",
    "test:provider-availability": "node test/provider-availability.test.js",
    "test:provider-readiness": "node test/provider-readiness.test.js",
    "test:conversation-context": "node test/conversation-context.test.js",
    "test:update-check": "node test/update-check.test.js",
    "test:third-party-notices": "node test/third-party-notices.test.js",
    "test:provider-credentials": "node test/provider-credentials.test.js",
    "test:provider-registry": "node test/provider-registry.test.js",
    "test:alibaba": "node test/alibaba-provider.test.js",
    "test:request-context": "node test/request-context.test.js",
    "test:provider-cancellation": "node test/provider-cancellation.test.js",
    "test:cloud-consent": "node test/cloud-consent.test.js",
    "test:network-security": "node test/network-security.test.js",
    "test:knowledge-scope": "node scripts/run-electron-test.js test/knowledge-scope.test.js",
    "test:knowledge-cli": "node test/knowledge-scope-cli.test.js",
    "test:electron-renderer": "node scripts/run-electron-test.js test/electron-renderer-integration.test.js",
    "test:electron-security": "node scripts/run-electron-test.js test/electron-security.test.js",
    "test:image-download-electron": "node scripts/run-electron-test.js test/image-download-electron.test.js",
    "knowledge:preflight": "electron scripts/knowledge-scope-repair.js",
    "knowledge:repair": "electron scripts/knowledge-scope-repair.js",
    "test:ci-gates": "node test/ci-gates.test.js",
    "test:palette": "node test/palette.test.js",
    "test:visual-ui-shell": "node test/visual-ui-shell.test.js",
    "test:visual-ui-conversation": "node test/visual-ui-conversation.test.js",
    "test:electron-test-isolation": "node test/electron-test-isolation.test.js",
    "test:visual-ui-polish": "node test/visual-ui-polish.test.js",
