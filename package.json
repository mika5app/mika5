    "test:xlsx-vendored": "node test/xlsx-vendored.test.js",
    "test:kill-survivors": "node test/kill-survivors.test.js",
    "test:ensure-electron-binary": "node test/ensure-electron-binary.test.js"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "highlight.js": "^11.11.1",
    "mammoth": "^1.12.0",
    "marked": "^17.0.4",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296",
