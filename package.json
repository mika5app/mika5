    "test:all": "bash scripts/run-stage0a-gates.sh",
    "test:db": "node scripts/run-electron-test.js test/db.test.js",
    "test:rag": "node test/rag.test.js",
    "test:vision": "node test/vision.test.js",
    "test:provider-capabilities": "node test/provider-capabilities.test.js",
    "test:alibaba": "node test/alibaba-provider.test.js",
    "test:request-context": "node test/request-context.test.js",
    "test:provider-cancellation": "node test/provider-cancellation.test.js",
    "test:cloud-consent": "node test/cloud-consent.test.js",
    "test:network-security": "node test/network-security.test.js",
    "test:knowledge-scope": "node scripts/run-electron-test.js test/knowledge-scope.test.js",
    "test:knowledge-cli": "node test/knowledge-scope-cli.test.js",
    "test:electron-renderer": "node scripts/run-electron-test.js test/electron-renderer-integration.test.js",
    "test:electron-security": "node scripts/run-electron-test.js test/electron-security.test.js",
    "test:image-download-electron": "node scripts/run-electron-test.js test/image-download-electron.test.js",
    "knowledge:preflight": "electron scripts/knowledge-scope-repair.js",
    "knowledge:repair": "electron scripts/knowledge-scope-repair.js",
    "test:ci-gates": "node test/ci-gates.test.js",
    "test:palette": "node test/palette.test.js",
    "test:visual-ui-shell": "node test/visual-ui-shell.test.js",
    "test:visual-ui-conversation": "node test/visual-ui-conversation.test.js",
    "test:electron-test-isolation": "node test/electron-test-isolation.test.js",
    "test:visual-ui-polish": "node test/visual-ui-polish.test.js",
    "test:ipc-contracts": "node test/ipc-contracts.test.js",
    "test:website-i18n": "node test/website-i18n.test.js",
    "test:print-pdf-electron": "node scripts/run-electron-test.js test/print-pdf-electron.test.js",
    "test:provider-selector": "node scripts/run-electron-test.js test/provider-selector.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "highlight.js": "^11.11.1",
    "mammoth": "^1.12.0",
    "marked": "^17.0.4",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5",
    "xlsx-parse-json": "^3.1.1"
  },
