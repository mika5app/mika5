{
  "appId": "com.mika5.desktop",
  "productName": "MIKA5",
  "copyright": "© 2026 MIKA5",
  "directories": {
    "output": "dist",
    "buildResources": "build"
  },
  "files": [
    "src/**/*",
    "package.json",
    "!**/.env",
    "!**/.env.*",
    "!**/*.key",
    "!**/*.pem",
    "!**/*.p12",
    "!**/*.pfx",
    "!**/*.secret",
    "!**/*.secrets",
    "!**/.git/**",
    "!**/test/**",
    "!**/*.test.js",
    "!**/node_modules/.bin/**",
    "!**/*.map",
    "!**/*.ts"
  ],
  "asarUnpack": [
    "**/node_modules/better-sqlite3/**"
  ],
  "electronFuses": {
    "enableEmbeddedAsarIntegrityValidation": true,
    "onlyLoadAppFromAsar": true
  },
  "extraMetadata": {
    "main": "src/main/main.js"
  },

  "win": {
    "target": [
      { "target": "nsis",     "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] }
    ],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "MIKA5",
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "artifactName": "MIKA5-Setup-${version}-win-${arch}.${ext}"
  },
  "portable": {
    "artifactName": "MIKA5-Portable-${version}-win-${arch}.${ext}"
  },

  "mac": {
    "target": [
      { "target": "dmg", "arch": ["x64", "arm64"] },
      { "target": "zip", "arch": ["x64", "arm64"] }
    ],
    "icon": "build/icon.icns",
    "category": "public.app-category.productivity",
    "darkModeSupport": true,
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist",
    "artifactName": "MIKA5-${version}-mac-${arch}.${ext}"
  },
  "dmg": {
    "title": "MIKA5 ${version}",
    "icon": "build/icon.icns",
    "iconSize": 80,
    "window": { "width": 560, "height": 400 },
    "contents": [
      { "x": 140, "y": 200, "type": "file" },
      { "x": 420, "y": 200, "type": "link", "path": "/Applications" }
    ]
  },

  "linux": {
    "target": [
      { "target": "AppImage", "arch": ["x64"] },
      { "target": "deb",      "arch": ["x64"] },
      { "target": "rpm",      "arch": ["x64"] }
    ],
    "icon": "src/renderer/assets/icon.png",
    "category": "Office",
    "description": "Local AI desktop with projects, chats, knowledge and RAG",
    "artifactName": "MIKA5-${version}-linux-${arch}.${ext}",
    "desktop": {
      "entry": {
        "Name": "MIKA5",
        "Comment": "Local AI desktop — run models privately on your PC",
        "Categories": "Office;Utility;Science;",
        "StartupWMClass": "mika5",
        "Keywords": "AI;LLM;Ollama;Chat;RAG;"
      }
    }
  },
  "deb": {
    "depends": [
      "libgtk-3-0",
      "libnotify4",
      "libnss3",
      "libxss1",
      "libxtst6",
      "xdg-utils",
      "libatspi2.0-0",
      "libuuid1"
    ],
    "recommends": ["ollama"],
    "afterInstall": "build/scripts/postinstall.sh",
    "afterRemove": "build/scripts/postrm.sh"
  },
  "rpm": {
    "depends": [
      "libnotify",
      "libXtst",
      "xdg-utils",
      "at-spi2-atk"
    ]
  },
  "appImage": {
    "license": "LICENSE"
  },

  "publish": {
    "provider": "github",
    "releaseType": "release"
  }
}
